# Yandex Cloud Search API v2 — ключи для проверки частотности.
# Скопируй в .env и подставь свои. Файл .env в репозиторий не коммитится.

# Api-Key сервисного аккаунта Yandex Cloud с ролью search-api.webSearch.user
YANDEX_API_KEY=

# Идентификатор каталога Yandex Cloud, в котором создан сервисный аккаунт
YANDEX_FOLDER_ID=
